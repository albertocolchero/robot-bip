{
  "expo": {
    "name": "Bip",
    "slug": "bip",
    "version": "1.2.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.albertocolchero.bip",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Bip usa la cámara frontal para verte y seguirte con la mirada. Las imágenes no salen del iPhone.",
        "NSMicrophoneUsageDescription": "Bip usa el micrófono para oír lo que le dices. El sonido no sale del iPhone.",
        "NSSpeechRecognitionUsageDescription": "Bip convierte tu voz en texto dentro del iPhone para entenderte.",
        "NSPhotoLibraryUsageDescription": "Bip no mira ni guarda tus fotos. Apple pide esta frase porque una de las piezas de la app sabe abrir la fototeca."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true,
        "com.apple.developer.kernel.extended-virtual-addressing": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#000000"
    },
    "updates": {
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/80565dd7-4b85-4226-89fe-ea46ec1143fe"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-asset",
      [
        "expo-sensors",
        {
          "motionPermission": "Bip nota cuándo lo mueves o lo levantas."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "80565dd7-4b85-4226-89fe-ea46ec1143fe"
      }
    },
    "owner": "albertocolchero"
  }
}
